# Copy to .env and configure your local environment.
# Generate a key with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

DJANGO_SECRET_KEY=replace-with-a-generated-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

DB_NAME=ai_stock_market
DB_USER=replace-with-your-postgres-user
DB_PASSWORD=replace-with-your-postgres-password
DB_HOST=localhost
DB_PORT=5432

# Production-only: set real https:// origins and enable HTTPS where your
# reverse proxy terminates TLS. Never use DEBUG=true in production.
DJANGO_CSRF_TRUSTED_ORIGINS=
FRONTEND_BASE_URL=http://localhost:5173
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_TRUST_PROXY_SSL_HEADER=false
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false

# Set an SMTP email backend in production to enable password reset and verification.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=MarketPulse <noreply@example.com>

# Local Docker preview ONLY. Never reuse production or original DB passwords.
PREVIEW_DB_PASSWORD=replace-with-strong-isolated-password
PREVIEW_DJANGO_SECRET_KEY=replace-with-unique-generated-random-key
# Default preview omits optional ~hundreds-of-MB PyTorch/Transformers download.
# Set true only if you need the FinBERT analyze_news_sentiment management job.
PREVIEW_WITH_FINBERT=false

# If a chosen secret contains $, enclose its ENTIRE value in single quotes
# in preview.env so Docker Compose does not interpolate part of the secret.
